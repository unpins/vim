Hook the unpins glue into main(): unpins_xxd_dispatch() runs first (argv[0]
"xxd" runs the folded xxd and exits), unpins_init() right after
mch_early_init() pins $VIMRUNTIME/$VIM at the embedded runtime.

--- a/src/main.c
+++ b/src/main.c
@@ -1,3 +1,5 @@
+extern void unpins_init(void);
+extern void unpins_xxd_dispatch(int, char **);
 /* vi:set ts=8 sts=4 sw=4 noet:
  *
  * VIM - Vi IMproved	by Bram Moolenaar
@@ -105,7 +107,9 @@
      * Do any system-specific initialisations.  These can NOT use IObuff or
      * NameBuff.  Thus emsg2() cannot be called!
      */
+    unpins_xxd_dispatch(argc, argv);
     mch_early_init();
+    unpins_init();
 
