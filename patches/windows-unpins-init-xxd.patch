Windows: VimMain() ignores the argv it is handed and re-reads the wide
command line with get_cmd_argsW() after mch_early_init(). Pin the
environment after mch_early_init() as on Unix, but dispatch xxd only after
get_cmd_argsW(): before it argv[0] is the unreliable narrow value.

--- a/src/main.c
+++ b/src/main.c
@@ -1,3 +1,5 @@
+extern void unpins_init(void);
+extern void unpins_xxd_dispatch(int, char **);
 /* vi:set ts=8 sts=4 sw=4 noet:
  *
  * VIM - Vi IMproved	by Bram Moolenaar
@@ -106,6 +108,7 @@
      * NameBuff.  Thus emsg2() cannot be called!
      */
     mch_early_init();
+    unpins_init();
 
 #  ifdef MSWIN
     /*
@@ -113,6 +116,7 @@
      * convert when 'encoding' changes.  Get the unexpanded arguments.
      */
     argc = get_cmd_argsW(&argv);
+    unpins_xxd_dispatch(argc, argv);
 #  endif
 
     // Many variables are in "params" so that we can pass them to invoked
